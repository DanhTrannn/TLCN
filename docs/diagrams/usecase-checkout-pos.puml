@startuml
title D&K E-Commerce — Use Case phân rã bán hàng
left to right direction
skinparam backgroundColor #F7F4EE
skinparam defaultFontName DejaVu Sans
skinparam ArrowColor #315B4F
skinparam actorBorderColor #315B4F
skinparam usecaseBorderColor #315B4F
skinparam usecaseBackgroundColor #FFFDF9
skinparam rectangleBorderColor #DCD8CF
skinparam rectangleBackgroundColor #ECE6DA

actor "Khách hàng" as Customer
actor "Nhân viên cửa hàng" as Staff

rectangle "Mua hàng online" {
  usecase "Xem báo giá\nđơn hàng" as Quote
  usecase "Checkout" as Checkout
  usecase "Kiểm tra giỏ hàng\nvà tồn kho" as ValidateOnline
  usecase "Áp dụng coupon" as Coupon
  usecase "Ghi đơn hàng\nvà thanh toán" as PersistOnline
}

rectangle "Bán hàng POS" {
  usecase "Lập đơn tại quầy" as POS
  usecase "Kiểm tra tồn kho\ncửa hàng" as ValidateStore
  usecase "Ghi đơn POS\nvà thanh toán" as PersistPOS
}

Customer --> Quote
Customer --> Checkout
Staff --> POS
Checkout ..> ValidateOnline : <<include>>
Checkout ..> PersistOnline : <<include>>
Coupon ..> Checkout : <<extend>>
POS ..> ValidateStore : <<include>>
POS ..> PersistPOS : <<include>>

note bottom of POS
  POS có thể phục vụ khách vãng lai.
  Không tạo cart; trừ store_inventory.
end note
@enduml
