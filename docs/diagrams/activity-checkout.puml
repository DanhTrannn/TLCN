@startuml
title D&K E-Commerce — Activity checkout online
skinparam backgroundColor #F7F4EE
skinparam defaultFontName DejaVu Sans
skinparam ArrowColor #315B4F
skinparam activityBorderColor #315B4F
skinparam activityBackgroundColor #FFFDF9
skinparam diamondBorderColor #A94728
skinparam diamondBackgroundColor #F5DCCA

start
:Khách hàng xác nhận đơn COD hoặc VietQR;
:FastAPI xác thực, kiểm tra CSRF và Idempotency-Key;
if (Idempotency-Key đã dùng?) then (Có)
  :Trả kết quả đơn đã tạo;
  stop
else (Không)
endif
:Bắt đầu transaction MySQL;
:Khóa customer và cart đang hoạt động;
if (COD bị chặn hoặc cart không hợp lệ?) then (Có)
  :Rollback và trả lỗi;
  stop
else (Không)
endif
:Khóa cart_items và catalog;
:Kiểm tra sản phẩm còn bán;
if (Dữ liệu không hợp lệ?) then (Có)
  :Rollback và trả lỗi;
  stop
else (Không)
endif
:Kiểm tra coupon nếu được nhập;
:Tính tổng tiền và snapshot giá;
:Tạo order;
:Khóa, kiểm tra và trừ tồn kho;
if (Tồn kho không đủ?) then (Có)
  :Rollback toàn bộ transaction;
  :Trả lỗi hết hàng;
  stop
else (Không)
endif
:Ghi inventory_transactions và order_items;
if (Thanh toán COD?) then (Có)
  :Order = confirmed; Payment = pending;
else (Không, VietQR)
  :Order = paid; Payment = succeeded;
endif
:Ghi payment và order_status_history;
:Đánh dấu cart checked_out;
if (Ghi dữ liệu thành công?) then (Có)
  :Commit transaction;
  :Trả mã đơn hàng và trạng thái;
else (Không)
  :Rollback toàn bộ transaction;
  :Trả lỗi;
endif
stop
@enduml
