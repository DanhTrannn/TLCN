Ref: inbound_receipt_items.variant_id > product_variants.variant_id [delete: restrict, color: #315b4f]
Ref: inbound_receipts.created_by_customer_id > customers.customer_id [delete: restrict, color: #315b4f]
Ref: inventory.variant_id - product_variants.variant_id [delete: restrict, color: #315b4f]
Ref: inventory_transactions.store_id >? stores.store_id [delete: restrict, color: #315b4f]
Ref: inventory_transactions.variant_id > product_variants.variant_id [delete: restrict, color: #315b4f]
Ref: order_items.order_id > orders.order_id [delete: restrict, color: #315b4f]
Ref: order_items.variant_id > product_variants.variant_id [delete: restrict, color: #315b4f]
Ref: order_status_history.order_id > orders.order_id [delete: restrict, color: #315b4f]
Ref: orders.cart_id -? carts.cart_id [delete: restrict, color: #315b4f]
Ref: orders.coupon_id >? coupons.coupon_id [delete: restrict, color: #315b4f]
Ref: orders.customer_id >? customers.customer_id [delete: restrict, color: #315b4f]
Ref: orders.staff_id >? customers.customer_id [color: #315b4f]
Ref: orders.store_id >? stores.store_id [color: #315b4f]
Ref: payments.order_id - orders.order_id [delete: restrict, color: #315b4f]
Ref: product_reviews.customer_id > customers.customer_id [delete: restrict, color: #315b4f]
Ref: product_reviews.moderated_by_customer_id >? customers.customer_id [delete: restrict, color: #315b4f]
Ref: product_reviews.order_item_id - order_items.order_item_id [delete: restrict, color: #315b4f]
Ref: product_reviews.product_id > products.product_id [delete: restrict, color: #315b4f]
Ref: product_variants.product_id > products.product_id [delete: restrict, color: #315b4f]
