  public_id binary(16) [not null]
  return_code varchar(64) [not null]
  order_id bigint [not null, note: 'unsigned']
  customer_id bigint [not null, note: 'unsigned']
  action_type varchar(16) [not null]
  status varchar(32) [not null]
  customer_reason text [not null]
  image_urls json
  admin_note text
  reviewed_at datetime(6)
  resolved_at datetime(6)
  created_at datetime(6) [not null]
  updated_at datetime(6) [not null]

  indexes {
    customer_id [name: 'ix_return_requests_customer_id']
    order_id [name: 'ix_return_requests_order_id']
    status [name: 'ix_return_requests_status']
    (updated_at, return_id) [name: 'ix_return_requests_updated_at_return_id']
    return_code [name: 'uq_return_requests_code', unique]
    public_id [name: 'uq_return_requests_public_id', unique]
  }
}

Table return_items [headercolor: #315b4f] {
  return_item_id bigint [pk, not null, note: 'unsigned']
  public_id binary(16) [not null]
  return_id bigint [not null, note: 'unsigned']
  order_item_id bigint [not null, note: 'unsigned']
  variant_id bigint [not null, note: 'unsigned']
  quantity integer [not null, note: 'unsigned']
  exchange_variant_id bigint [note: 'unsigned']
  refund_amount_vnd bigint [not null, note: 'unsigned']
  inspection_status varchar(16) [not null]
  created_at datetime(6) [not null]
  updated_at datetime(6) [not null]

  indexes {
    return_id [name: 'ix_return_items_return_id']
    (updated_at, return_item_id) [name: 'ix_return_items_updated_at_item_id']
    variant_id [name: 'ix_return_items_variant_id']
    public_id [name: 'uq_return_items_public_id', unique]
  }
}

// Foreign keys. A question mark on the referenced end means the FK is nullable.
