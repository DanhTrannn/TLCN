// D&K E-Commerce OLTP — 28 tables, generated from app.models SQLAlchemy metadata.
// Regenerate: .venv/bin/python docs/diagrams/export_oltp_dbml.py
// Physical DDL: database/schema.sql; ORM mapping: services/ecommerce-api/app/models/.
// Visualization only: defaults, CHECK expressions, and server-side behavior are defined in schema.sql.
// customer_credentials contains authentication data and is excluded from Lakehouse extraction.

// Identity
Table customers [headercolor: #315b4f] {
  customer_id bigint [pk, not null, note: 'unsigned']
  public_id binary(16) [not null]
  role varchar(32) [not null]
  display_name varchar(120) [not null]
  status varchar(16) [not null]
  city_id bigint [note: 'unsigned']
  store_id bigint [note: 'unsigned']
  is_cod_blocked boolean [not null]
  boom_count integer [not null, note: 'unsigned']
  cod_reinstated_at datetime(6)
  cod_reinstated_by bigint [note: 'unsigned']
  cod_reinstatement_reason varchar(255)
  data_origin varchar(16) [not null]
  generation_run_id varchar(64)
  anonymized_at datetime(6)
  created_at datetime(6) [not null]
  updated_at datetime(6) [not null]

  indexes {
    (role, status, customer_id) [name: 'ix_customers_role_status_id']
    (updated_at, customer_id) [name: 'ix_customers_updated_at_customer_id']
    public_id [name: 'uq_customers_public_id', unique]
  }
}

Table customer_credentials [headercolor: #315b4f] {
  customer_id bigint [pk, not null, note: 'unsigned']
  email_normalized varchar(320) [not null]
  password_hash varchar(255) [not null]
  is_enabled boolean [not null]
  password_changed_at datetime(6) [not null]
  created_at datetime(6) [not null]
  updated_at datetime(6) [not null]

  indexes {
    email_normalized [name: 'uq_customer_credentials_email_normalized', unique]
  }
}

