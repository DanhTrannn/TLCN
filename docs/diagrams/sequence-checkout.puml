@startuml
title D&K E-Commerce — Sequence checkout online
skinparam backgroundColor #F7F4EE
skinparam defaultFontName DejaVu Sans
skinparam ArrowColor #315B4F
skinparam ParticipantBorderColor #315B4F
skinparam ParticipantBackgroundColor #ECE6DA
skinparam ActorBorderColor #315B4F
skinparam NoteBackgroundColor #FFFDF9
skinparam NoteBorderColor #DCD8CF

actor "Khách hàng" as Customer
participant "Next.js\nStorefront" as Web
participant "FastAPI\nCheckout" as API
database "MySQL\nOLTP" as DB

Customer -> Web : Xác nhận mua hàng
Web -> API : POST /api/v1/checkout\nCookie + CSRF + Idempotency-Key
API -> API : Xác thực và kiểm tra header
API -> DB : BEGIN; khóa customer
API -> DB : Tìm order theo Idempotency-Key
alt Đơn đã tồn tại
  DB --> API : Order + Payment hiện có
  API -> DB : Kết thúc giao dịch đọc
  API --> Web : Trả lại kết quả cũ
else Checkout mới
  API -> DB : Khóa cart, cart_items, catalog
  API -> DB : Kiểm tra catalog và coupon
  alt Catalog hoặc coupon không hợp lệ
    API -> DB : ROLLBACK
    API --> Web : 4xx với mã lỗi nghiệp vụ
  else Hợp lệ
    API -> DB : INSERT orders
    API -> DB : SELECT inventory FOR UPDATE
    alt Tồn kho không đủ
      API -> DB : ROLLBACK
      API --> Web : 409 OUT_OF_STOCK
    else Còn hàng
      API -> DB : UPDATE inventory; INSERT inventory_transactions
      API -> DB : INSERT order_items, payments, status_history
      API -> DB : UPDATE carts = checked_out
      alt COD
        note over API,DB : Order confirmed; Payment pending
      else VietQR
        note over API,DB : Order paid; Payment succeeded
      end
      API -> DB : COMMIT
      API --> Web : order_number + trạng thái
    end
  end
end
Web --> Customer : Hiển thị kết quả checkout

note over API
  Không có lời gọi cổng thanh toán ngoài
  trong transaction checkout hiện tại.
end note
@enduml
