{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://d-and-k.local/schemas/ecommerce-access-v1.schema.json",
  "title": "D&K ecommerce completed HTTP request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "timestamp", "observed_timestamp", "severity_text",
    "severity_number", "request", "trace_id", "span_id", "service",
    "event", "http", "actor", "client", "ecommerce", "error", "data_origin"
  ],
  "properties": {
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"const": "ecommerce.access"},
        "version": {"const": "1.0.0"}
      }
    },
    "timestamp": {"type": "string", "format": "date-time"},
    "observed_timestamp": {"type": "string", "format": "date-time"},
    "severity_text": {"enum": ["INFO", "WARN", "ERROR"]},
    "severity_number": {"enum": [9, 13, 17]},
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {"id": {"type": "string", "pattern": "^[0-9a-f]{32}$"}}
    },
    "trace_id": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^[0-9a-f]{32}$"}
      ]
    },
    "span_id": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^[0-9a-f]{16}$"}
      ]
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "environment", "instance_id"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 64},
        "version": {"type": "string", "minLength": 1, "maxLength": 32},
        "environment": {"type": "string", "minLength": 1, "maxLength": 32},
        "instance_id": {"type": "string", "minLength": 1, "maxLength": 128}
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "category", "kind", "outcome", "duration_ns"],
      "properties": {
        "name": {"const": "http.server.request"},
        "category": {"const": "web"},
        "kind": {"const": "event"},
        "outcome": {"enum": ["success", "failure", "unknown"]},
        "duration_ns": {"type": "integer", "minimum": 0}
      }
    },
    "http": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_method", "route", "status_code"],
      "properties": {
        "request_method": {"enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "OPTIONS"]},
        "route": {"type": "string", "minLength": 1, "maxLength": 240},
        "status_code": {"type": "integer", "minimum": 100, "maximum": 599}
      }
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "key"],
      "properties": {
        "type": {"enum": ["anonymous", "customer", "admin", "system"]},
        "key": {"type": ["string", "null"], "maxLength": 128}
      }
    },
    "client": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"user_agent": {"type": "string", "maxLength": 512}}
    },
    "ecommerce": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action"],
      "properties": {
        "action": {"type": "string", "minLength": 1, "maxLength": 64},
        "product_key": {"type": "string", "maxLength": 180},
        "variant_key": {"type": "string", "maxLength": 64},
        "search_query": {"type": "string", "maxLength": 100},
        "search_redacted": {"type": "boolean"},
        "filters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "category": {"type": "string", "maxLength": 64},
            "size": {"type": "array", "maxItems": 10, "items": {"type": "string", "maxLength": 32}},
            "color": {"type": "array", "maxItems": 10, "items": {"type": "string", "maxLength": 64}},
            "min_price_vnd": {"type": "integer", "minimum": 0},
            "max_price_vnd": {"type": "integer", "minimum": 0},
            "in_stock": {"type": "boolean"},
            "sort": {"enum": ["newest", "price_asc", "price_desc"]}
          }
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "type"],
      "properties": {
        "code": {"type": ["string", "null"], "maxLength": 64},
        "type": {"type": ["string", "null"], "maxLength": 128}
      }
    },
    "data_origin": {"enum": ["observed", "synthetic"]}
  }
}
