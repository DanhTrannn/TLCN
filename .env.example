# ==============================================================================
# D&K E-Commerce Data Platform - Environment Configuration
# Copy this file to .env and update values for your environment.
# ==============================================================================

# --- Active Compose Profiles (start all services by default) ---
COMPOSE_PROFILES=core,batch,streaming

# --- Core Web (MySQL + FastAPI + Next.js) ---
MYSQL_DATABASE=ecommerce
MYSQL_USER=ecommerce_app
MYSQL_PASSWORD=password
MYSQL_ROOT_PASSWORD=password
MYSQL_PORT=3306

# Dedicated least-privilege MySQL replication account for Debezium.
MYSQL_CDC_USER=debezium
MYSQL_CDC_PASSWORD=password
CDC_TOPIC_PREFIX=ecommerce
CDC_FLINK_GROUP_ID=flink-oltp-cdc-bronze-v1
CDC_CONNECT_BIND_ADDRESS=127.0.0.1
CDC_CONNECT_PORT=8086

API_SECRET_KEY=change-me-with-at-least-32-random-characters
API_CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
STOREFRONT_PORT=3000
API_PORT=8000

# Bootstrap admin account (created on first startup)
API_BOOTSTRAP_ADMIN_EMAIL=admin@web.local
API_BOOTSTRAP_ADMIN_PASSWORD=Admin@12345
API_BOOTSTRAP_ADMIN_DISPLAY_NAME=Admin

# --- PostgreSQL (metadata for Polaris & Airflow) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_PORT=5432

# Polaris catalog database
POLARIS_DB_NAME=polaris
POLARIS_DB_USER=polaris
POLARIS_DB_PASSWORD=password

# Airflow metadata database
AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=password

# --- Data Platform & Security (NĐ 13/2023/NĐ-CP PII Salting) ---
SILVER_PSEUDONYMIZE_SALT=ecommerce_lakehouse_pii_salt_2026_nd13_secure

# --- Object Storage (MinIO) ---
MINIO_BIND_ADDRESS=127.0.0.1
MINIO_ROOT_USER=minio-root
MINIO_ROOT_PASSWORD=lakehouse-root-dev-secret-2026
MINIO_LAKEHOUSE_BUCKET=lakehouse
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Per-service MinIO identities (dev-only values).
MINIO_POLARIS_ACCESS_KEY=lakehouse-polaris
MINIO_POLARIS_SECRET_KEY=lakehouse-polaris-dev-secret-2026
MINIO_SPARK_ACCESS_KEY=lakehouse-spark
MINIO_SPARK_SECRET_KEY=lakehouse-spark-dev-secret-2026
MINIO_FLINK_ACCESS_KEY=lakehouse-flink
MINIO_FLINK_SECRET_KEY=lakehouse-flink-dev-secret-2026
MINIO_AIRFLOW_ACCESS_KEY=lakehouse-airflow
MINIO_AIRFLOW_SECRET_KEY=lakehouse-airflow-dev-secret-2026
MINIO_TRINO_ACCESS_KEY=lakehouse-trino
MINIO_TRINO_SECRET_KEY=lakehouse-trino-dev-secret-2026
MINIO_TRINO_ADMIN_ACCESS_KEY=lakehouse-trino-admin
MINIO_TRINO_ADMIN_SECRET_KEY=lakehouse-trino-admin-dev-secret-2026
MINIO_UPLOADER_ACCESS_KEY=lakehouse-uploader
MINIO_UPLOADER_SECRET_KEY=lakehouse-uploader-dev-secret-2026

AWS_REGION=us-east-1

# --- Apache Iceberg ---
ICEBERG_VERSION=1.10.1

# --- Apache Spark ---
SPARK_MASTER_UI_PORT=8082
SPARK_WORKER_UI_PORT=8083
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=2g

# --- Apache Polaris (REST Catalog) ---
POLARIS_REALM=POLARIS
POLARIS_CATALOG_NAME=lakehouse
POLARIS_ROOT_CLIENT_ID=root
POLARIS_ROOT_CLIENT_SECRET=lakehouse-polaris-root-dev-secret-2026
POLARIS_BIND_ADDRESS=127.0.0.1
POLARIS_API_PORT=8181
POLARIS_MANAGEMENT_PORT=8182
POLARIS_CONSOLE_PORT=8183
POLARIS_CONSOLE_ORIGIN=http://localhost:8183
POLARIS_PUBLIC_API_URL=http://localhost:8181

# --- Trino (Query Engine) ---
TRINO_BIND_ADDRESS=127.0.0.1
TRINO_PORT=8084
TRINO_ADMIN_PORT=8087

# --- LibreDB Studio (Web Database GUI) ---
LIBREDB_STUDIO_PORT=8085


# --- Apache Airflow (Orchestration) ---
AIRFLOW_UID=50000
AIRFLOW_PORT=8080
AIRFLOW_SECRET_KEY=change-me-airflow-secret
AIRFLOW_FERNET_KEY=
AIRFLOW_ADMIN_USER=airflow
AIRFLOW_ADMIN_PASSWORD=password
PIPELINE_ENV=local
