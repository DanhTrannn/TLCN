# ==============================================================================
# D&K E-Commerce Data Platform - Environment Configuration
# Copy this file to .env and update values for your environment.
# ==============================================================================

# --- Core Web (MySQL + FastAPI + Next.js) ---
MYSQL_DATABASE=ecommerce
MYSQL_USER=ecommerce_app
MYSQL_PASSWORD=password
MYSQL_ROOT_PASSWORD=password
MYSQL_PORT=3306

API_SECRET_KEY=change-me-with-at-least-32-random-characters
API_CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
STOREFRONT_PORT=3000
API_PORT=8000

# Bootstrap admin account (created on first startup)
API_BOOTSTRAP_ADMIN_EMAIL=admin@web.local
API_BOOTSTRAP_ADMIN_PASSWORD=Admin@12345
API_BOOTSTRAP_ADMIN_DISPLAY_NAME=Admin

# --- PostgreSQL (metadata for Polaris, Airflow, Superset, Hue) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_PORT=5432

# Polaris catalog database
POLARIS_DB_NAME=polaris
POLARIS_DB_USER=polaris
POLARIS_DB_PASSWORD=password

# Airflow metadata database
AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=password

# Superset metadata database
SUPERSET_DB_NAME=superset
SUPERSET_DB_USER=superset
SUPERSET_DB_PASSWORD=password

# Hue metadata database (created by postgres init script)
HUE_DB_PASSWORD=password

# --- Object Storage (MinIO) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=password
MINIO_LAKEHOUSE_BUCKET=lakehouse
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
AWS_REGION=us-east-1

# --- Fluent Bit (Log Collector) ---
FLUENT_BIT_UPLOAD_TIMEOUT=15m
# Set to true only for initial bootstrap/backfill of existing Docker logs
FLUENT_BIT_READ_FROM_HEAD=false

# --- Apache Iceberg ---
ICEBERG_VERSION=1.10.1

# --- Apache Spark ---
SPARK_MASTER_UI_PORT=8082
SPARK_WORKER_UI_PORT=8083
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=2g

# --- Apache Polaris (REST Catalog) ---
POLARIS_REALM=POLARIS
POLARIS_CATALOG_NAME=lakehouse
POLARIS_ROOT_CLIENT_ID=root
POLARIS_ROOT_CLIENT_SECRET=password
POLARIS_API_PORT=8181
POLARIS_MANAGEMENT_PORT=8182
POLARIS_CONSOLE_PORT=8183
POLARIS_CONSOLE_ORIGIN=http://localhost:8183
POLARIS_PUBLIC_API_URL=http://localhost:8181

# --- Trino (Query Engine) ---
TRINO_PORT=8084

# --- Apache Superset (BI Dashboards) ---
SUPERSET_PORT=8088
SUPERSET_SECRET_KEY=change-me-superset-secret
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=password

# --- Apache Hue (SQL Query UI) ---
HUE_PORT=8888

# --- Apache Airflow (Orchestration) ---
AIRFLOW_UID=50000
AIRFLOW_PORT=8080
AIRFLOW_SECRET_KEY=change-me-airflow-secret
AIRFLOW_FERNET_KEY=
AIRFLOW_ADMIN_USER=airflow
AIRFLOW_ADMIN_PASSWORD=password
PIPELINE_ENV=local
